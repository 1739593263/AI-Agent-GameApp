{
  "mcpServers": {
    "app-mcp-server": {
      "command": "java",
      "args": [
        "-Dspring.ai.mcp.server.stdio=true",
        "-Dspring.main.web-application-type=none",
        "-Dlogging.pattern.console=",
        "-jar",
        "agent-mcp-server/target/agent-mcp-server-0.0.1-SNAPSHOT.jar"
      ],
      "env": {}
    },
    "gamebrain": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://api.gamebrain.co/v1/mcp?api-key=YOUR_KEY"
      ]
    }
  }
}